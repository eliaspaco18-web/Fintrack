# ============================================================
# SUPABASE — Copiar desde: supabase.com → tu proyecto → Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role: SOLO servidor, NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ID del proyecto (para CLI: supabase gen types, supabase db push)
SUPABASE_PROJECT_ID=<project-id>

# ============================================================
# EXCHANGE RATE — https://exchangerate-api.com (plan gratuito)
# ============================================================
EXCHANGE_RATE_API_KEY=<api-key>
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron secret (solo producción)
CRON_SECRET=<genera-uno-random-con: openssl rand -hex 32>

# ============================================================
# E2E (Playwright) — opcional para smoke autenticado
# ============================================================
E2E_USER_EMAIL=<usuario-de-prueba@correo.com>
E2E_USER_PASSWORD=<password-del-usuario-de-prueba>
